# ==============================================================================
# CLASSROOM ERP — ENTERPRISE PRODUCTION CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & SCALABILITY (Local SQLite vs AWS RDS / PostgreSQL)
# ------------------------------------------------------------------------------
# Development default:
DATABASE_URL="file:./dev.db"

# Production PostgreSQL (AWS RDS / Supabase / Neon / Google Cloud SQL):
# DATABASE_URL="postgresql://postgres:YourSecurePassword@classroom-db.cluster-xyz.us-east-1.rds.amazonaws.com:5432/classroom_production?sslmode=require&pgbouncer=true"

# ------------------------------------------------------------------------------
# 2. DISTRIBUTED CACHE & SESSION STORE (Redis / Upstash)
# ------------------------------------------------------------------------------
# For multi-server clusters, rate-limiting & instant token revocation across pods:
# UPSTASH_REDIS_REST_URL="https://YOUR-UPSTASH-INSTANCE.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="YourUpstashSecretRestTokenHere"
# Or standard Redis URI:
# REDIS_URL="redis://:password@redis-cluster.internal:6379"

# ------------------------------------------------------------------------------
# 3. ENTERPRISE CLOUD OBJECT STORAGE (AWS S3 / Cloudflare R2 / MinIO)
# ------------------------------------------------------------------------------
STORAGE_DRIVER="local" # "local" or "s3"
STORAGE_LOCAL_PATH="./public/uploads"

# AWS S3 / Cloudflare R2 Configuration:
# S3_BUCKET="classroom-institutional-assets"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
# S3_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
# Optional custom S3-compatible endpoint (for Cloudflare R2 or MinIO):
# S3_ENDPOINT="https://xyz.r2.cloudflarestorage.com"

# ------------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL DISPATCHERS (SendGrid / Resend)
# ------------------------------------------------------------------------------
# Twilio SendGrid v3 API:
# SENDGRID_API_KEY="SG.your_sendgrid_production_api_key_here"

# Or Resend HTTP API:
# RESEND_API_KEY="re_your_resend_production_api_key_here"

EMAIL_FROM="CLASSROOM University <notifications@classroom.edu>"

# ------------------------------------------------------------------------------
# 5. ONLINE PAYMENT GATEWAYS (Razorpay / Stripe)
# ------------------------------------------------------------------------------
# Razorpay (India & International Cards / UPI / NetBanking):
# RAZORPAY_KEY_ID="rzp_live_your_live_key_id"
# RAZORPAY_KEY_SECRET="your_live_secret_key"

# Stripe (Global Credit Cards, ACH, SEPA):
# STRIPE_SECRET_KEY="sk_live_your_stripe_secret_key"
# STRIPE_WEBHOOK_SECRET="whsec_your_webhook_signing_secret"

# ------------------------------------------------------------------------------
# 6. ENTERPRISE SINGLE SIGN-ON (Google Workspace & Microsoft 365 Entra ID)
# ------------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Credentials:
# GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="GOCSPX-your-google-secret"

# Microsoft Azure Active Directory / Entra ID:
# AZURE_CLIENT_ID="your-azure-application-client-id"
# AZURE_CLIENT_SECRET="your-azure-client-secret-value"
# AZURE_TENANT_ID="your-azure-directory-tenant-id"

# ------------------------------------------------------------------------------
# 7. HARDWARE BIOMETRIC TURNSTILES (ZKTeco / Suprema ADMS API)
# ------------------------------------------------------------------------------
BIOMETRIC_DEVICE_KEY="apex-biometric-secret-2026"

# ------------------------------------------------------------------------------
# 8. ARTIFICIAL INTELLIGENCE & LLM (Google Gemini / OpenAI)
# ------------------------------------------------------------------------------
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-3.8-flash"
# Add your Gemini or OpenAI API Key here for live autonomous reasoning:
LLM_API_KEY=""

# ------------------------------------------------------------------------------
# 9. CRYPTOGRAPHIC SECRETS & SIGNATURE KEYS
# ------------------------------------------------------------------------------
AUTH_SECRET="classroom-super-secret-encryption-key-for-jwt-and-session"
JWT_SECRET="classroom-super-secret-encryption-key-for-jwt-and-session"
RESET_SECRET="classroom-production-password-reset-key-2026-secure"
NEXT_PUBLIC_APP_NAME="CLASSROOM"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 10. FREE FIREBASE AUTHENTICATION (DEVELOPMENT / TRIAL SYSTEM)
# Zero SMS Cost: Google Sign-In, Email/Password, and Test Phone Numbers
# Deployable on Vercel Hobby for trial evaluation
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-app-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-app.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# Comma-separated test phone numbers and static verification codes (zero SMS charges):
NEXT_PUBLIC_FIREBASE_TEST_PHONE_NUMBERS="+16505551234:123456,+919999999999:123456,+16505554321:654321"

