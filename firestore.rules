rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to verify user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if current user matches target document UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check user role from their profile document
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'SUPER_ADMIN' || getUserRole() == 'INSTITUTION_ADMIN');
    }
    
    function isFaculty() {
      return isAuthenticated() && (getUserRole() == 'FACULTY' || isAdmin());
    }

    // 1. Users collection: users can read and write only their own profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // 2. Courses collection: all authenticated users can view, faculty & admin can manage
    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isFaculty();
    }
    
    // 3. Attendance collection: students read their own records, faculty create/manage
    match /attendance/{sessionId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isFaculty();
    }
    
    // 4. Announcements collection: public institutional noticeboard
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isFaculty();
    }
    
    // 5. Timetable collection: readable by all authenticated scholars & staff
    match /timetable/{slotId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isFaculty();
    }
  }
}
